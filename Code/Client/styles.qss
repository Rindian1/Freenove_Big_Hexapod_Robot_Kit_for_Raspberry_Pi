/* Main Window Styles */
QMainWindow {
    background-color: #2b2b2b;
    color: #f0f0f0;
}

/* Button Styles */
QPushButton {
    background-color: #3a3a3a;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 5px;
    color: #f0f0f0;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #4a4a4a;
    border: 1px solid #666;
}

QPushButton:pressed {
    background-color: #2a2a2a;
}

QPushButton:checked {
    background-color: #4a6da7;
    border: 1px solid #5d8fd9;
}

/* Slider Styles */
QSlider::groove:horizontal {
    border: 1px solid #555;
    height: 8px;
    background: #3a3a3a;
    margin: 2px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #5d8fd9;
    border: 1px solid #4a6da7;
    width: 18px;
    margin: -4px 0;
    border-radius: 4px;
}

/* Line Edit Styles */
QLineEdit {
    background-color: #3a3a3a;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 5px;
    color: #f0f0f0;
}

/* Label Styles */
QLabel {
    color: #f0f0f0;
}

/* Group Box Styles */
QGroupBox {
    border: 1px solid #555;
    border-radius: 4px;
    margin-top: 1ex;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
}

/* Progress Bar Styles */
QProgressBar {
    border: 1px solid #555;
    border-radius: 4px;
    text-align: center;
    background: #3a3a3a;
}

QProgressBar::chunk {
    background: #5d8fd9;
    width: 1px;
}

/* Radio Button Styles */
QRadioButton {
    color: #f0f0f0;
    spacing: 5px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #555;
    background: #3a3a3a;
}

QRadioButton::indicator:checked {
    background: #5d8fd9;
    border: 1px solid #4a6da7;
}

/* Scroll Bar Styles */
QScrollBar:vertical {
    border: 1px solid #555;
    background: #3a3a3a;
    width: 10px;
    margin: 15px 0 15px 0;
}

QScrollBar::handle:vertical {
    background: #5d8fd9;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: 1px solid #555;
    background: #3a3a3a;
    height: 15px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
