{
    "version": "1.0",
    "poses": {
        "stand": {
            "type": "pose",
            "description": "Standard standing position",
            "leg_positions": {
                "all": {"x": 100, "y": 0, "z": -120}
            },
            "duration": 1000,
            "easing": "ease_in_out"
        },
        "sit": {
            "type": "pose",
            "description": "Sitting position",
            "leg_positions": {
                "all": {"x": 100, "y": 0, "z": -80}
            },
            "duration": 800,
            "easing": "ease_in_out"
        },
        "wave_hello": {
            "type": "pose",
            "description": "Raise front right leg to wave",
            "leg_positions": {
                "1": {"x": 150, "y": 0, "z": -100},
                "default": {"x": 100, "y": 0, "z": -120}
            },
            "duration": 500,
            "easing": "ease_in_out"
        }
    },
    "gaits": {
        "tripod": {
            "type": "gait",
            "description": "Tripod gait for efficient forward/backward movement",
            "cycle_time": 1000,
            "duty_factor": 0.5,
            "swing_height": 40,
            "step_length": 60,
            "body_height": 100,
            "leg_groups": [
                [0, 2, 4],  // Left front, right middle, left back
                [1, 3, 5]   // Right front, left middle, right back
            ]
        },
        "wave": {
            "type": "gait",
            "description": "Wave gait for stable but slower movement",
            "cycle_time": 2000,
            "duty_factor": 0.75,
            "swing_height": 40,
            "step_length": 60,
            "body_height": 100,
            "leg_sequence": [0, 3, 1, 4, 2, 5]
        }
    },
    "sequences": {
        "wake_up": {
            "type": "sequence",
            "description": "Wake up and stand up sequence",
            "steps": [
                {"type": "pose", "name": "sit", "duration": 1000},
                {"type": "delay", "duration": 300},
                {"type": "pose", "name": "stand", "duration": 1000}
            ]
        },
        "dance": {
            "type": "sequence",
            "description": "Fun dance sequence",
            "repeat": 2,
            "steps": [
                {"type": "pose", "name": "wave_hello", "duration": 500},
                {"type": "delay", "duration": 300},
                {"type": "gait", "name": "wave", "duration": 2000, "params": {"direction": "left"}},
                {"type": "gait", "name": "wave", "duration": 2000, "params": {"direction": "right"}}
            ]
        }
    }
}
